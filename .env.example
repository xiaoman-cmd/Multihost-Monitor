MHM_DATABASE_URL=sqlite:///./data/monitor.db
MHM_ADMIN_USERNAME=admin
# Set a unique password of at least 12 characters before running deploy/dev.sh.
MHM_ADMIN_PASSWORD=
MHM_ORIGIN=http://127.0.0.1:8000
# Set true behind HTTPS in production.
MHM_COOKIE_SECURE=false
MHM_SESSION_HOURS=8

# Single-process bounded 7-day retention; disable only for isolated test/benchmark databases.
MHM_RETENTION_ENABLED=true

# One scheduler per database; exactly one Uvicorn worker.
MHM_SCHEDULER_ENABLED=true
# Independent explicit exceptions. Empty means public unicast only; metadata is always blocked.
MHM_PROBE_ALLOWED_CIDRS=[]
MHM_NOTIFICATION_ALLOWED_CIDRS=[]
# Owner-only local directory (0700), JSON files (0600); never commit actual secrets.
MHM_NOTIFICATION_SECRET_DIR=data/secrets
